; Engine configuration file.
; Godot 4.x project — Tidewrack
; UI and levels are built in code, so scene files stay minimal.

config_version=5

[application]

config/name="Tidewrack"
config/description="A narrative adventure set on a fog-bound island off the Washington coast. You are the new keeper of Cape Marrow Light. The last keeper vanished."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
Journal="*res://scripts/journal.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]

; Keyboard + controller (Public Demo milestone). Defining a ui_* action here
; REPLACES Godot's built-in bindings for it; nothing is layered. So each list
; repeats the built-in events (keys, D-pad, left stick) and adds the gamepad
; face button. Leave an event out and that input stops working.
;   ui_accept: Enter, keypad Enter, Space, gamepad A (button 0)
;   ui_cancel: Esc, gamepad B (button 1)
;   ui_left/right/up/down: arrow key, D-pad (buttons 13/14/11/12), left stick
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309), Object(InputEventKey,"keycode":4194310), Object(InputEventKey,"keycode":32), Object(InputEventJoypadButton,"button_index":0)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305), Object(InputEventJoypadButton,"button_index":1)]
}
ui_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194319), Object(InputEventJoypadButton,"button_index":13), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
ui_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194321), Object(InputEventJoypadButton,"button_index":14), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
ui_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194320), Object(InputEventJoypadButton,"button_index":11), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
ui_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194322), Object(InputEventJoypadButton,"button_index":12), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}

[global]

; Steam Next Fest demo build — feature-frozen for the public demo (2026-08).
demo_build=true
